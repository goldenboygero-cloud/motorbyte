---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  author?: string;
  publishedAt?: Date;
  updatedAt?: Date;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  image,
  imageAlt,
  type = 'website',
  author,
  publishedAt,
  updatedAt,
  structuredData,
} = Astro.props;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImage = image
  ? new URL(image, Astro.site ?? Astro.url).toString()
  : undefined;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const structuredDataJson = structuredData
  ? JSON.stringify(structuredData).replace(/</g, '\\u003c')
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0F172A" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="icon" type="image/png" href="/images/MotorByte%20Logo.png" />
    {author && <meta name="author" content={author} />}
    <title>{title}</title>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="alternate" type="application/rss+xml" title="MotorByte RSS feed" href="/feed.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="MotorByte" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:alt" content={imageAlt ?? title} />}
    {type === 'article' && author && <meta property="article:author" content={author} />}
    {type === 'article' && publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {type === 'article' && updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {structuredDataJson && <script type="application/ld+json" set:html={structuredDataJson} />}
    {adsenseClient && /^ca-pub-\d+$/.test(adsenseClient) && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
        crossorigin="anonymous"
      />
    )}
    <slot name="head" />
  </head>
  <body class="min-h-screen antialiased">
    <div class="flex min-h-screen flex-col">
      <header class="site-header">
        <nav class="site-nav" aria-label="Main navigation">
          <a href="/" class="brand" aria-label="MotorByte home">
            <img src="/images/MotorByte%20Logo.png" alt="MotorByte Automotive Media" class="brand-mark" />
            <span class="brand-text">motorbyte<span>.net</span></span>
          </a>

          <div class="nav-links" aria-label="Primary navigation">
            <a
              class:list={Astro.url.pathname === '/' ? ['is-active'] : []}
              href="/"
              aria-current={Astro.url.pathname === '/' ? 'page' : undefined}
            >Home</a>
            <a
              class:list={Astro.url.pathname === '/about/' ? ['is-active'] : []}
              href="/about/"
              aria-current={Astro.url.pathname === '/about/' ? 'page' : undefined}
            >About</a>
          </div>
        </nav>
      </header>

      <main class="flex-1">
        <slot />
      </main>

      <footer id="about" class="border-t border-line bg-ink">
        <div class="mx-auto flex max-w-7xl flex-col gap-3 px-5 py-8 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between sm:px-8">
          <a href="/" class="flex w-fit items-center" aria-label="MotorByte home">
            <img src="/images/MotorByte%20Logo.png" alt="MotorByte Automotive Media" class="h-14 w-14 object-contain" />
          </a>
          <p>Stories for people who love cars.</p>
          <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Footer navigation">
            <a class="transition hover:text-cyan-300" href="/">Home</a>
            <a class="transition hover:text-cyan-300" href="/about/">About</a>
          </nav>
        </div>
      </footer>
    </div>
  </body>
</html>
