---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const categories = [
    { slug: 'news', title: 'News' },
    { slug: 'reviews', title: 'Reviews' },
    { slug: 'opinion', title: 'Opinion' },
    { slug: 'comparisons', title: 'Comparisons' },
    { slug: 'car-culture', title: 'Car Culture' },
  ];
  const posts = await getCollection('blog');
  return categories.map((category) => ({
    params: { category: category.slug },
    props: {
      category,
      posts: posts
        .filter((post) => post.data.category.toLowerCase() === category.title.toLowerCase())
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { category, posts } = Astro.props;
const publishedDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout
  title={`${category.title} | MotorByte`}
  description={`${category.title} stories from MotorByte, a place for people who love cars.`}
>
  <section class="page-shell py-12 sm:py-16">
    <header class="mb-8">
      <p class="eyebrow">MotorByte stories</p>
      <h1 class="text-4xl font-black tracking-tight text-white sm:text-5xl">{category.title}</h1>
    </header>

    {posts.length > 0 ? (
      <div class="article-grid">
        {posts.map((post) => (
          <article class="story-card">
            <a class="story-card-link" href={`/blog/${post.id}/`} aria-label={`Read ${post.data.title}`}>
              <div class="story-body">
                <span class="story-tag">{post.data.category}</span>
                <h2>{post.data.title}</h2>
                <p class="story-description">{post.data.description}</p>
                <div class="story-meta">
                  <time datetime={post.data.pubDate.toISOString()}>{publishedDate(post.data.pubDate)}</time>
                  <span>{post.data.author}</span>
                </div>
                <span class="story-read-more">Read article <span aria-hidden="true">→</span></span>
              </div>
            </a>
          </article>
        ))}
      </div>
    ) : (
      <p class="empty-stories">There are no {category.title.toLowerCase()} stories yet. Check back later.</p>
    )}
  </section>
</BaseLayout>
