---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featuredPost = posts[0];
const latestPosts = posts.slice(1);
const publishedDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout
  title="MotorByte | Performance in Focus"
  description="Performance-driven stories, reviews, and car culture from the world of motorsport and modern performance cars."
>
  <div class="page-shell">
    {featuredPost && (
      <section
        class:list={['hero-panel', !featuredPost.data.heroImage && 'hero-panel-no-image']}
        style={featuredPost.data.heroImage ? `--hero-image: url("${featuredPost.data.heroImage}")` : undefined}
      >
        <div class="hero-content">
          <div class="hero-copy">
            <p class="eyebrow">Editor's pick</p>
            <h1>{featuredPost.data.title}</h1>
            <p class="dek">{featuredPost.data.description}</p>

            <div class="meta-row">
              <span class="meta-item">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 2h2v2h6V2h2v2h3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h3V2Zm13 8H4v10h16V10ZM4 8h16V6H4v2Z"/></svg>
                <time datetime={featuredPost.data.pubDate.toISOString()}>{publishedDate(featuredPost.data.pubDate)}</time>
              </span>
              <span class="meta-item">{featuredPost.data.author}</span>
            </div>

            <a href={`/blog/${featuredPost.id}/`} class="cta-button">
              Read More <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>
    )}

    <section class="content-grid">
      <div class="cards-column">
        <div class="section-header">
          <h2>Latest Articles</h2>
        </div>

        {latestPosts.length > 0 ? (
          <div class="article-grid">
            {latestPosts.map((post) => (
              <article class="story-card">
                <a class="story-card-link" href={`/blog/${post.id}/`} aria-label={`Read ${post.data.title}`}>
                  <div class="story-body">
                    <span class="story-tag">{post.data.category}</span>
                    <h3>{post.data.title}</h3>
                    <p class="story-description">{post.data.description}</p>
                    <div class="story-meta">
                      <time datetime={post.data.pubDate.toISOString()}>{publishedDate(post.data.pubDate)}</time>
                      <span>{post.data.author}</span>
                    </div>
                    <span class="story-read-more">Read article <span aria-hidden="true">→</span></span>
                  </div>
                </a>
              </article>
            ))}
          </div>
        ) : posts.length === 0 ? (
          <p class="empty-stories">No stories yet. Check back soon for the latest from MotorByte.</p>
        ) : (
          <p class="empty-stories">You’re all caught up. Check back soon for more MotorByte stories.</p>
        )}
      </div>

      {posts.length > 0 && (
        <aside class="sidebar">
          <div class="popular-panel">
            <h3>Explore Stories</h3>
            <ol>
              {posts.map((post, index) => (
                <li>
                  <span class="rank" aria-hidden="true">{index + 1}</span>
                  <a href={`/blog/${post.id}/`} aria-label={`Read ${post.data.title}`}>
                    <h4>{post.data.title}</h4>
                    <span>{post.data.category} · {publishedDate(post.data.pubDate)}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>

          <div class="newsletter-box">
            <div class="newsletter-icon" aria-hidden="true">✓</div>
            <h3>Stay Updated</h3>
            <p>Get the latest articles, news and insights delivered to your inbox.</p>

            <label class="newsletter-form">
              <input type="email" placeholder="Your email address..." aria-label="Email address" />
              <button type="button">Subscribe</button>
            </label>
          </div>
        </aside>
      )}
    </section>
  </div>
</BaseLayout>
