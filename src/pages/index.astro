---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featuredPost = posts[0];
const recentPosts = posts.slice(1);
const categories = [...new Set(posts.map((post) => post.data.category))];
const siteUrl = Astro.site ?? new URL('https://motorbyte.example');
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#organization`,
      name: 'MotorByte',
      url: siteUrl.toString(),
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: 'MotorByte',
      url: siteUrl.toString(),
      description: 'A personal automotive blog about the cars, people, ideas, and news shaping life on the road.',
      publisher: { '@id': `${siteUrl}#organization` },
      inLanguage: 'en',
    },
    {
      '@type': 'Blog',
      '@id': `${siteUrl}#blog`,
      name: 'MotorByte stories',
      url: siteUrl.toString(),
      publisher: { '@id': `${siteUrl}#organization` },
      blogPost: posts.map((post) => ({
        '@type': 'BlogPosting',
        headline: post.data.title,
        url: new URL(`/blog/${post.id}/`, siteUrl).toString(),
        datePublished: post.data.pubDate.toISOString(),
        author: { '@type': 'Person', name: post.data.author },
      })),
    },
  ],
};
---

<BaseLayout
  title="MotorByte | Stories from the world of cars"
  description="A personal automotive blog about the cars, people, ideas, and news shaping life on the road."
  structuredData={structuredData}
>
  <section class="border-b border-line bg-panel">
    <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-24">
      <p class="text-xs font-bold uppercase tracking-[0.22em] text-orange-400">An independent car blog</p>
      <h1 class="mt-5 max-w-4xl text-4xl font-black leading-tight tracking-tight text-white sm:text-6xl">
        Cars are more than <span class="text-orange-400">getting there.</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
        Fresh stories about the machines we love, the people behind them, and whatever is happening in the automotive world.
      </p>
      <a href="#stories" class="mt-8 inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-3 font-bold text-ink transition hover:bg-orange-300">
        Browse the latest <span aria-hidden="true">↓</span>
      </a>
    </div>
  </section>

  {featuredPost && (
    <section class="mx-auto max-w-7xl px-5 py-12 sm:px-8 sm:py-16">
      <p class="mb-5 text-xs font-bold uppercase tracking-[0.2em] text-orange-400">Featured story</p>
      <article class="overflow-hidden rounded-2xl border border-line bg-panel">
        <a href={`/blog/${featuredPost.id}/`} class="grid md:grid-cols-2">
          {featuredPost.data.heroImage ? (
            <img src={featuredPost.data.heroImage} alt={featuredPost.data.heroImageAlt ?? featuredPost.data.title} class="aspect-[16/9] h-64 w-full object-cover md:h-full md:min-h-80" loading="eager" fetchpriority="high" />
          ) : (
            <div class="grid min-h-64 place-items-center bg-[radial-gradient(ellipse_at_60%_40%,rgba(249,115,22,0.24),transparent_55%),linear-gradient(135deg,#1d2730,#0b0e11)] md:min-h-80">
              <span class="text-6xl font-black tracking-tighter text-white/10" aria-hidden="true">MOTORBYTE</span>
            </div>
          )}
          <div class="flex flex-col justify-center p-6 sm:p-10">
            <div class="flex items-center gap-3 text-xs text-slate-500">
              <span class="font-bold uppercase tracking-widest text-orange-300">{featuredPost.data.category}</span>
              <time datetime={featuredPost.data.pubDate.toISOString()}>
                {featuredPost.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </div>
            <h2 class="mt-5 text-2xl font-bold leading-tight text-white sm:text-4xl">{featuredPost.data.title}</h2>
            <p class="mt-4 leading-7 text-slate-400">{featuredPost.data.description}</p>
            <span class="mt-7 font-bold text-orange-400">Read the story <span aria-hidden="true">→</span></span>
          </div>
        </a>
      </article>
    </section>
  )}

  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <AdSlot slot={import.meta.env.PUBLIC_ADSENSE_HOME_SLOT} />
  </div>

  <section id="stories" class="mx-auto max-w-7xl px-5 pb-16 sm:px-8 sm:pb-20">
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-orange-400">From the blog</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">Latest stories</h2>
      </div>
      {categories.length > 0 && (
        <ul class="flex flex-wrap gap-2" aria-label="Story categories">
          {categories.map((category) => (
            <li class="rounded-full border border-line px-3 py-1 text-xs text-slate-400">{category}</li>
          ))}
        </ul>
      )}
    </div>

    {recentPosts.length > 0 ? (
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {recentPosts.map((post) => (
          <article class="group overflow-hidden rounded-xl border border-line bg-panel transition hover:-translate-y-1 hover:border-slate-600">
            <a href={`/blog/${post.id}/`} class="flex h-full flex-col">
              {post.data.heroImage ? (
                <img src={post.data.heroImage} alt={post.data.heroImageAlt ?? post.data.title} class="aspect-[16/9] w-full object-cover" loading="lazy" />
              ) : (
                <div class="grid aspect-[16/9] place-items-center bg-[radial-gradient(ellipse_at_60%_40%,rgba(249,115,22,0.16),transparent_55%),linear-gradient(135deg,#1d2730,#0b0e11)]">
                  <span class="text-3xl font-black tracking-tighter text-white/10" aria-hidden="true">MOTORBYTE</span>
                </div>
              )}
              <div class="flex flex-1 flex-col p-6">
                <div class="flex items-center justify-between gap-3 text-xs">
                  <span class="font-bold uppercase tracking-widest text-orange-300">{post.data.category}</span>
                  <time class="text-slate-500" datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                  </time>
                </div>
                <h3 class="mt-4 text-xl font-bold leading-snug text-slate-100 transition group-hover:text-orange-300">{post.data.title}</h3>
                <p class="mt-3 flex-1 text-sm leading-6 text-slate-400">{post.data.description}</p>
                <span class="mt-6 text-sm font-bold text-orange-400">Read more <span aria-hidden="true">→</span></span>
                <span class="mt-4 border-t border-line pt-4 text-xs text-slate-500">By {post.data.author}</span>
              </div>
            </a>
          </article>
        ))}
      </div>
    ) : posts.length === 0 ? (
      <p class="rounded-xl border border-line bg-panel p-8 text-slate-400">No stories yet. Add a Markdown post to <code>src/content/blog</code> to publish your first one.</p>
    ) : (
      <p class="rounded-xl border border-line bg-panel p-8 text-slate-400">That’s the latest story. Add a Markdown post to <code>src/content/blog</code> to publish another.</p>
    )}
  </section>
</BaseLayout>
